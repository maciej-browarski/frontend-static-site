---
const dropdownLinks = ['Link nr 1', 'Link nr 2', 'Link nr 3', 'Link nr 4', 'Link nr 5'];
---
<div class="bg-black text-white text-[11px] md:text-xs py-2.5 px-4 font-sans select-none tracking-wide relative z-50">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2 pr-12 md:pr-4 relative">
    
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-6 w-full sm:w-auto items-start sm:items-center">
      <div class="flex items-center gap-2">
        <svg class="w-4.5 h-4.5 text-white shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.557-5.115-3.848-6.672-6.672l1.293-.97a1.125 1.125 0 00.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        <span class="font-medium">+48 123 456 789</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4.5 h-4.5 text-white shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0l-7.5-4.615a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        <span class="font-medium text-gray-200">abc@abc.defgh.abc</span>
      </div>
    </div>

    <div class="flex items-center gap-2 w-full sm:w-auto justify-start sm:justify-end">
      <svg class="w-4.5 h-4.5 text-white shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25s-7.5-4.108-7.5-11.25a7.5 7.5 0 1115 0z" />
      </svg>
      <span class="font-medium text-gray-200">00-001 Abcde, ul. Abcdefgh 1/2</span>
    </div>

    <nav 
      id="mobile-navigation" 
      class="mobile-nav-menu flex-col w-64 justify-center gap-2 bg-gray-50 p-4 shadow-xl rounded-lg absolute right-0 top-[2.5rem] border border-gray-200/60 box-border"
    >
      <a href="/" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-center text-xs font-bold tracking-wide px-6 py-2.5 rounded">
        ABCDE
      </a>

      <div class="relative mobile-dropdown text-center w-full">
        <!-- Zmiana: Dodane justify-center, aby tekst i strzałka były idealnie na środku przycisku -->
        <button class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold tracking-wide px-6 py-2.5 rounded flex items-center justify-center gap-2 cursor-pointer select-none mobile-dropdown-btn">
          ABCDEFGHI
          <svg class="w-3 h-3 text-gray-500 transition-transform duration-200 mobile-dropdown-arrow shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
        </button>
        <!-- Zmiana: text-center na podlinkach w rozwijanym menu -->
        <div class="hidden mobile-dropdown-menu bg-white border border-gray-200 rounded shadow-lg flex flex-col overflow-hidden py-1 box-border mt-1 text-center">
          {dropdownLinks.map((link) => (
            <a href="/" class="px-4 py-2 text-xs text-gray-700 hover:bg-gray-100 font-medium border-b border-gray-50 last:border-none text-center block w-full box-border">{link}</a>
          ))}
        </div>
      </div>

      <div class="relative mobile-dropdown text-center w-full">
        <!-- Zmiana: Dodane justify-center -->
        <button class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold tracking-wide px-6 py-2.5 rounded flex items-center justify-center gap-2 cursor-pointer select-none mobile-dropdown-btn">
          ABCDE
          <svg class="w-3 h-3 text-gray-500 transition-transform duration-200 mobile-dropdown-arrow shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
        </button>
        <!-- Zmiana: text-center na podlinkach -->
        <div class="hidden mobile-dropdown-menu bg-white border border-gray-200 rounded shadow-lg flex flex-col overflow-hidden py-1 box-border mt-1 text-center">
          {dropdownLinks.map((link) => (
            <a href="/" class="px-4 py-2 text-xs text-gray-700 hover:bg-gray-100 font-medium border-b border-gray-50 last:border-none text-center block w-full box-border">{link}</a>
          ))}
        </div>
      </div>

      <a href="/" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-center text-xs font-bold tracking-wide px-6 py-2.5 rounded">
        ABCDEFG
      </a>
    </nav>
  </div>

  <button 
    id="mobile-toggle" 
    class="md:hidden absolute right-4 top-3 text-white focus:outline-none cursor-pointer z-50 p-1" 
    aria-label="Toggle menu"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path id="mobile-hamburger-icon" class="block" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      <path id="mobile-close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<style>
  .mobile-nav-menu {
    display: none;
  }
  @media (min-width: 768px) {
    .mobile-nav-menu {
      display: none !important;
    }
  }
</style>

<script>
  const mobileToggle = document.getElementById('mobile-toggle');
  const mobileNavigation = document.getElementById('mobile-navigation');
  const hamburgerIcon = document.getElementById('mobile-hamburger-icon');
  const closeIcon = document.getElementById('mobile-close-icon');

  if (mobileToggle && mobileNavigation && hamburgerIcon && closeIcon) {
    mobileToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isMenuHidden = window.getComputedStyle(mobileNavigation).display === 'none';

      if (isMenuHidden) {
        mobileNavigation.style.display = 'flex';
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        mobileNavigation.style.display = 'none';
        hamburgerIcon.classList.remove('hidden');
        hamburgerIcon.classList.add('block');
        closeIcon.classList.add('hidden');
      }
    });
  }

  const mobileDropdowns = document.querySelectorAll('.mobile-dropdown');
  mobileDropdowns.forEach(container => {
    const btn = container.querySelector('.mobile-dropdown-btn');
    const menu = container.querySelector('.mobile-dropdown-menu');
    const arrow = container.querySelector('.mobile-dropdown-arrow');

    if (btn && menu && arrow) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isCurrentlyOpen = !menu.classList.contains('hidden');

        mobileDropdowns.forEach(other => {
          other.querySelector('.mobile-dropdown-menu')?.classList.add('hidden');
          other.querySelector('.mobile-dropdown-arrow')?.classList.remove('rotate-180');
        });

        if (!isCurrentlyOpen) {
          menu.classList.remove('hidden');
          arrow.classList.add('rotate-180');
        }
      });
    }
  });

  document.addEventListener('click', () => {
    if (mobileNavigation && window.getComputedStyle(mobileNavigation).display !== 'none') {
      mobileNavigation.style.display = 'none';
      if (hamburgerIcon) {
        hamburgerIcon.classList.remove('hidden');
        hamburgerIcon.classList.add('block');
      }
      closeIcon?.classList.add('hidden');
    }
  });
</script>
