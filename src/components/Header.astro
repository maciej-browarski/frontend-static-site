---
const dropdownLinks = ['Link nr 1', 'Link nr 2', 'Link nr 3', 'Link nr 4', 'Link nr 5'];
---
<header class="max-w-6xl mx-auto px-4 py-6 md:py-10 relative font-sans select-none">
  <div class="flex flex-col items-center gap-6 md:gap-8">
    
    <div class="flex items-center justify-center w-full md:w-auto gap-4 md:h-16 text-center max-w-full">
      <div class="flex items-center justify-center gap-3 md:gap-5 max-w-full">
        <div class="bg-black text-white text-xl md:text-3xl font-black w-10 h-10 md:w-16 md:h-16 flex items-center justify-center shrink-0">
          Y
        </div>
        <h1 class="text-base md:text-2xl font-bold tracking-tight text-gray-950 md:whitespace-nowrap break-words text-left">
          Advisor Outcome Paper PATTERN
        </h1>
      </div>
    </div>

    <nav id="desktop-navigation" class="hidden md:flex flex-row justify-center gap-2 bg-transparent p-0 relative top-0 z-40 border-none box-border">
      <a href="/" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-center text-sm font-bold tracking-wide px-6 py-2.5 rounded">
        ABCDE
      </a>

      <div class="relative desktop-dropdown text-left w-auto">
        <button class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-bold tracking-wide px-6 py-2.5 rounded flex items-center justify-between gap-2 cursor-pointer select-none desktop-dropdown-btn">
          ABCDEFGHI
          <svg class="w-3 h-3 text-gray-500 transition-transform duration-200 desktop-dropdown-arrow shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
        </button>
        <div class="hidden desktop-dropdown-menu absolute left-0 mt-1 w-48 bg-white border border-gray-200 rounded shadow-lg z-50 flex flex-col overflow-hidden py-1 box-border">
          {dropdownLinks.map((link) => (
            <a href="/" class="px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 font-medium border-b border-gray-50 last:border-none text-left">{link}</a>
          ))}
        </div>
      </div>

      <div class="relative desktop-dropdown text-left w-auto">
        <button class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-bold tracking-wide px-6 py-2.5 rounded flex items-center justify-between gap-2 cursor-pointer select-none desktop-dropdown-btn">
          ABCDE
          <svg class="w-3 h-3 text-gray-500 transition-transform duration-200 desktop-dropdown-arrow shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
        </button>
        <div class="hidden desktop-dropdown-menu absolute left-0 mt-1 w-48 bg-white border border-gray-200 rounded shadow-lg z-50 flex flex-col overflow-hidden py-1 box-border">
          {dropdownLinks.map((link) => (
            <a href="/" class="px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 font-medium border-b border-gray-50 last:border-none text-left">{link}</a>
          ))}
        </div>
      </div>

      <a href="/" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-center text-sm font-bold tracking-wide px-6 py-2.5 rounded">
        ABCDEFG
      </a>
    </nav>
  </div>
</header>

<script>
  const desktopDropdowns = document.querySelectorAll('.desktop-dropdown');
  desktopDropdowns.forEach(container => {
    const btn = container.querySelector('.desktop-dropdown-btn');
    const menu = container.querySelector('.desktop-dropdown-menu');
    const arrow = container.querySelector('.desktop-dropdown-arrow');

    if (btn && menu && arrow) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isCurrentlyOpen = !menu.classList.contains('hidden');

        desktopDropdowns.forEach(other => {
          other.querySelector('.desktop-dropdown-menu')?.classList.add('hidden');
          other.querySelector('.desktop-dropdown-arrow')?.classList.remove('rotate-180');
        });

        if (!isCurrentlyOpen) {
          menu.classList.remove('hidden');
          arrow.classList.add('rotate-180');
        }
      });
    }
  });

  document.addEventListener('click', () => {
    desktopDropdowns.forEach(container => {
      container.querySelector('.desktop-dropdown-menu')?.classList.add('hidden');
      container.querySelector('.desktop-dropdown-arrow')?.classList.remove('rotate-180');
    });
  });
</script>
