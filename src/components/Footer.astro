---
const currentYear = new Date().getFullYear();
---
<footer class="bg-black text-gray-400 text-xs py-6 mt-16 border-t border-gray-800 font-sans select-none tracking-wide">
  <div class="max-w-3xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
    <div>
      <p class="font-medium text-white">
        &copy; {currentYear} Advisor Outcome Paper PATTERN.
      </p>
      <p class="text-[10px] text-gray-500 mt-1">
        All rights reserved. Designed for high performance and SEO optimization.
      </p>
    </div>
    <div class="flex gap-4 font-medium">
      <a href="/" class="hover:text-white transition-colors">Privacy Policy</a>
      <a href="/" class="hover:text-white transition-colors">Terms of Service</a>
    </div>
  </div>
</footer>
